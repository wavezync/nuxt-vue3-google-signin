{
  "name": "nuxt-vue3-google-signin",
  "version": "1.0.0",
  "description": "Nuxt module for vue3-google-signin: Google Sign-in with Google Identity Services",
  "keywords": [
    "google login",
    "google signin",
    "google-login",
    "google-signin",
    "gsi",
    "nuxt",
    "nuxt module",
    "nuxt-module",
    "nuxt3",
    "nuxt4",
    "oauth2",
    "vue3 google auth",
    "vue3 google identity services",
    "vue3 google oauth2",
    "vue3 google signin",
    "vue3-google-signin"
  ],
  "homepage": "https://vue3-google-signin.wavezync.com",
  "bugs": {
    "url": "https://github.com/wavezync/nuxt-vue3-google-signin/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Kasun Vithanage",
    "email": "alankasun@gmail.com",
    "url": "https://kasvith.me"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wavezync/nuxt-vue3-google-signin.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/module.mjs",
  "types": "./dist/types.d.mts",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "scripts": {
    "build": "nuxt-module-build build",
    "prepack": "nuxt-module-build build",
    "dev": "nuxi dev playground",
    "dev:build": "nuxi build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
    "typecheck": "vue-tsc --noEmit && pnpm --filter e2e typecheck",
    "test": "pnpm build && pnpm --filter e2e test",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "changelog": "node scripts/changelog.mjs"
  },
  "dependencies": {
    "@nuxt/kit": "^4.6.2",
    "defu": "^6.1.7",
    "vue3-google-signin": "^3.0.1"
  },
  "devDependencies": {
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.6.2",
    "@types/node": "^26.6.5",
    "git-cliff": "^2.14.2",
    "nuxt": "^4.6.2",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "typescript": "~7.0.2",
    "vue-tsc": "^3.3.13"
  },
  "packageManager": "pnpm@12.15.0"
}
